    <Import Project="$(NuGetPackageRoot)system.clientmodel\1.11.0\buildTransitive\net10.0\System.ClientModel.targets" Condition="Exists('$(NuGetPackageRoot)system.clientmodel\1.11.0\buildTransitive\net10.0\System.ClientModel.targets')" />
